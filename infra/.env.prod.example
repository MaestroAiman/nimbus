# Variables pour `docker compose -f docker-compose.prod.yml up`.
# Copier ce fichier en `.env.prod` (jamais commite, voir .gitignore) a cote de ce fichier
# et renseigner de vraies valeurs.

POSTGRES_USER=nimbus
POSTGRES_PASSWORD=change-me-mot-de-passe-postgres-de-prod
POSTGRES_DB=nimbus

# Generer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-32-char-secret

# En local sur le PC de dev pour verifier le compose prod : http://localhost:3000.
# Sur le Dell (etape 10, derriere Tailscale) : URL publique de l'API.
BETTER_AUTH_URL=http://localhost:3000

# Origine du frontend autorisee en CORS - doit correspondre a WEB_PORT ci-dessous.
CORS_ORIGIN=http://localhost:8080

# URL de l'API compilee en dur dans le bundle frontend au build (voir note dans
# apps/web/Dockerfile) - doit correspondre a API_PORT ci-dessous.
VITE_API_URL=http://localhost:3000

# Ports publies sur l'hote.
API_PORT=3000
WEB_PORT=8080
