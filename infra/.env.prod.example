# Variables pour `docker compose -f docker-compose.prod.yml up`.
# Copier ce fichier en `.env.prod` (jamais commite, voir .gitignore) a cote de ce fichier
# et renseigner de vraies valeurs.

POSTGRES_USER=nimbus
POSTGRES_PASSWORD=change-me-mot-de-passe-postgres-de-prod
POSTGRES_DB=nimbus

# Generer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-32-char-secret

# Depuis l'etape 10 : origine PUBLIQUE unique (Nginx sert le frontend ET proxifie /api),
# plus l'origine interne de l'API. En local sur le PC de dev : http://localhost:8080
# (= WEB_PORT). Sur le Dell derriere Tailscale : adresse ou nom Tailscale + WEB_PORT,
# ex. http://100.x.y.z:8080 ou http://dell.tailnet-name.ts.net:8080.
BETTER_AUTH_URL=http://localhost:8080

# Origine(s) autorisee(s) par Better Auth (verification CSRF de l'en-tete Origin) - doit
# lister la meme origine publique que BETTER_AUTH_URL ci-dessus.
CORS_ORIGIN=http://localhost:8080

# Port publie sur l'hote pour le reverse proxy Nginx (seul point d'entree depuis
# l'etape 10 : l'API n'est plus publiee separement, voir docker-compose.prod.yml).
WEB_PORT=8080
