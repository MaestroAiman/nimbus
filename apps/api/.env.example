# Port d'écoute de l'API NestJS
PORT=3000

# Connexion PostgreSQL (utilisée à partir de l'étape 2/3)
DATABASE_URL=postgres://nimbus:nimbus@localhost:5432/nimbus

# Better Auth (étape 4) — générer une vraie valeur avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-32-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Stockage des fichiers uploadés (étape 5) — en production, chemin du volume Docker dédié
STORAGE_PATH=./storage

# Origine(s) autorisée(s) pour les requêtes cross-origin du frontend (étape 7)
# Liste separee par des virgules (Vite peut basculer de port si 5173 est occupe)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
